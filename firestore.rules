rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentRecordVersion() { return 'r1'; }

    function signedIn() {
      return request.auth != null;
    }

    function activeAccount() {
      return signedIn()
        && !exists(/databases/$(database)/documents/accountDeletionLocks/$(request.auth.uid));
    }

    function validColor(color) {
      return color is string
        && color.matches('^#[0-9a-fA-F]{6}$');
    }

    function validBand(colors, index) {
      return colors.size() <= index || validColor(colors[index]);
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'name', 'colors', 'headColor',
          'reachedLevel', 'reachedPrototypeLevel', 'updatedAt', 'recordVersion', 'progressVersion'
        ])
        && data.keys().hasOnly([
          'name', 'colors', 'headColor',
          'reachedLevel', 'reachedPrototypeLevel', 'updatedAt', 'recordVersion', 'progressVersion'
        ])
        && data.progressVersion == currentRecordVersion() && data.recordVersion == currentRecordVersion()
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.colors is list
        && data.colors.size() >= 1
        && data.colors.size() <= 8
        && validBand(data.colors, 0)
        && validBand(data.colors, 1)
        && validBand(data.colors, 2)
        && validBand(data.colors, 3)
        && validBand(data.colors, 4)
        && validBand(data.colors, 5)
        && validBand(data.colors, 6)
        && validBand(data.colors, 7)
        && validColor(data.headColor)
        && data.reachedLevel is int
        && data.reachedLevel >= 1
        && data.reachedLevel <= 1000000
        && data.reachedPrototypeLevel is int
        && data.reachedPrototypeLevel >= 1
        && data.reachedPrototypeLevel <= 1000000
        && data.updatedAt == request.time;
    }

    // Legacy profiles remain readable/deletable. Retired clients cannot publish.
    match /players/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Optional for old clients/documents; absent or null means unknown.
    function optionalScoreText(data, key, maxLength, pattern) {
      return !(key in data) || data[key] == null
        || (data[key] is string && data[key].size() >= 1 && data[key].size() <= maxLength
          && data[key].matches(pattern));
    }

    match /stageScores/{board}/entries/{uid} {
      function validScore() {
        let data = request.resource.data;
        return board.matches('^' + currentRecordVersion() + '_v[12345]_existing_[1-9][0-9]{0,5}$')
          && data.keys().hasAll(['moves', 'timeMs', 'updatedAt', 'recordVersion', 'scoreSpecVersion'])
          && data.keys().hasOnly(['moves', 'timeMs', 'updatedAt',
            'appVersion', 'buildNumber', 'platform', 'scoreSpecVersion', 'recordVersion'])
          && data.recordVersion == currentRecordVersion()
          && optionalScoreText(data, 'appVersion', 64, '^[0-9]+[.][0-9]+[.][0-9]+$')
          && optionalScoreText(data, 'buildNumber', 32, '^[0-9]+([.][0-9]+){0,2}$')
          && optionalScoreText(data, 'platform', 32, '^(iOS|Web)$')
          && optionalScoreText(data, 'scoreSpecVersion', 32, '^v[12345]$')
          && ((data.scoreSpecVersion == 'v1' && board.matches('^' + currentRecordVersion() + '_v1_.*$'))
            || (data.scoreSpecVersion == 'v2' && board.matches('^' + currentRecordVersion() + '_v2_.*$'))
            || (data.scoreSpecVersion == 'v3' && board.matches('^' + currentRecordVersion() + '_v3_.*$'))
            || (data.scoreSpecVersion == 'v4' && board.matches('^' + currentRecordVersion() + '_v4_.*$'))
            || (data.scoreSpecVersion == 'v5' && board.matches('^' + currentRecordVersion() + '_v5_.*$')))
          && data.moves is int && data.moves >= 1 && data.moves <= 1000000
          && data.timeMs is int && data.timeMs >= 0 && data.timeMs <= 604800000
          && data.updatedAt == request.time;
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;
      // Profiles use a reserved public board so retired clients' all-board
      // deletion scans remove these too. It is never a score/ranking board.
      allow create: if activeAccount() && request.auth.uid == uid
        && (board == currentRecordVersion() + '_players' ? validProfile(request.resource.data) : validScore());
      allow update: if activeAccount() && request.auth.uid == uid
        && (board == currentRecordVersion() + '_players' ? validProfile(request.resource.data)
          : (validScore() && (request.resource.data.moves < resource.data.moves
            || (request.resource.data.moves == resource.data.moves
              && request.resource.data.timeMs < resource.data.timeMs))));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // entries is reserved for public stage scores; group reads support debug cleanup.
    match /{path=**}/entries/{uid} {
      allow list: if signedIn() && request.query.limit <= 100;
    }

    match /accountDeletionLocks/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['requestedAt'])
        && request.resource.data.keys().hasOnly(['requestedAt'])
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if false;
    }
  }
}
