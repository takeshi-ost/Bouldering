rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validColor(color) {
      return color is string
        && color.matches('^#[0-9a-fA-F]{6}$');
    }

    function validBand(colors, index) {
      return colors.size() <= index || validColor(colors[index]);
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'name', 'colors', 'headColor',
          'reachedLevel', 'reachedPrototypeLevel', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'colors', 'headColor',
          'reachedLevel', 'reachedPrototypeLevel', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.colors is list
        && data.colors.size() >= 1
        && data.colors.size() <= 8
        && validBand(data.colors, 0)
        && validBand(data.colors, 1)
        && validBand(data.colors, 2)
        && validBand(data.colors, 3)
        && validBand(data.colors, 4)
        && validBand(data.colors, 5)
        && validBand(data.colors, 6)
        && validBand(data.colors, 7)
        && validColor(data.headColor)
        && data.reachedLevel is int
        && data.reachedLevel >= 1
        && data.reachedLevel <= 1000000
        && data.reachedPrototypeLevel is int
        && data.reachedPrototypeLevel >= 1
        && data.reachedPrototypeLevel <= 1000000
        && data.updatedAt == request.time;
    }

    match /players/{uid} {
      allow get: if signedIn();

      allow list: if signedIn()
        && request.query.limit <= 100;

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data);

      allow delete: if false;
    }

    match /stageScores/{board}/entries/{uid} {
      function validScore() {
        let data = request.resource.data;
        return board.matches('^v1_(existing|prototype)_[1-9][0-9]{0,5}$')
          && data.keys().hasAll(['moves', 'timeMs', 'updatedAt'])
          && data.keys().hasOnly(['moves', 'timeMs', 'updatedAt'])
          && data.moves is int && data.moves >= 1 && data.moves <= 1000000
          && data.timeMs is int && data.timeMs >= 0 && data.timeMs <= 604800000
          && data.updatedAt == request.time;
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;
      allow create: if signedIn() && request.auth.uid == uid && validScore();
      allow update: if signedIn() && request.auth.uid == uid && validScore()
        && (request.resource.data.moves < resource.data.moves
          || (request.resource.data.moves == resource.data.moves
            && request.resource.data.timeMs < resource.data.timeMs));
      allow delete: if false;
    }
  }
}
